# Vorlage für die Test-VM (docker-compose.yml).
# Kopieren nach .env.bwcloud und Werte anpassen. Die .env.bwcloud kommt NICHT ins Repository.
#   cp .env.example .env.bwcloud
#
# Alle Werte sind Pflicht. Für docker-compose.dev.yml (lokal) wird keine Datei gebraucht,
# dort gelten die Standardwerte.

# Passwörter
APP_DB_PASSWORD=change-me
KC_DB_PASSWORD=change-me
KC_ADMIN_PASSWORD=change-me

# Nur für docker-compose.yml (Test-VM): Domains, ohne http:// und ohne Port
APP_DOMAIN=app.example.org
API_DOMAIN=api.example.org
AUTH_DOMAIN=auth.example.org

# Port von nginx auf dem Rechner (Standard 8080)
HTTP_PORT=8080

# Welche Version der Images laufen soll (Standard latest)
IMAGE_TAG=latest